# Copy to .env for local overrides. Docker Compose interpolates this file
# when it is present. Do not put real production secrets in git.

ENVIRONMENT=development
JWT_SECRET=dev-only-change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=مدیر سیستم
# Demo staff. Change these before anyone else can reach the machine.
SALES_EMAIL=sales@example.com
SALES_PASSWORD=sales12345
SALES_NAME=کارشناس فروش
SUPPLIER_EMAIL=supplier@example.com
SUPPLIER_PASSWORD=supplier12345
SUPPLIER_NAME=کارشناس جذب تامین‌کننده

# Used by host-side alembic / uvicorn. Compose overrides these with service DNS names.
DATABASE_URL=postgresql+psycopg://irhub:irhub@localhost:5432/irhub
REDIS_URL=redis://localhost:6379/0
SEARXNG_URL=http://searxng:8080
# SearXNG's own outbound proxy. Empty follows HTTPS_PROXY. Use the same v2ray URL when direct HTTPS fails.
SEARXNG_PROXY=
# Optional paid search if SearXNG is empty or unreachable.
TAVILY_API_KEY=
BRAVE_API_KEY=
ARTIFACT_DIR=data/artifacts
TASK_MAX_STEPS=12
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
# Inbound mail. Empty means the email channel is not polled.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SSL=true
# Telegram, WhatsApp Cloud API, and Kavenegar. Empty channels show as not configured.
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WEBHOOK_TOKEN=
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
CHANNEL_DAILY_LIMIT=20
# Public LinkedIn/Facebook search uses SearXNG. The browser session is off by default.
# SOCIAL_SESSION_COOKIES is a Playwright cookie JSON list for the owner's own account.
# Using it can violate LinkedIn/Meta terms and get that account banned.
SOCIAL_PLAYWRIGHT_ENABLED=false
SOCIAL_SESSION_COOKIES=
SOCIAL_PLAYWRIGHT_MIN_SECONDS=30
SOCIAL_PLAYWRIGHT_HOURLY_LIMIT=5

# auto: mock replies when every provider key below is empty.
MOCK_LLM=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional fallback only. Not used to pick the primary strong/fast models.
# Free tier is about 50 free-model requests per day, and upstream 429s are common.
OPENROUTER_API_KEY=
# Leave blank to follow the key that is set.
# Gemini only: gemini/gemini-pro-latest and gemini/gemini-flash-latest.
# Anthropic only: anthropic/claude-sonnet-4-5 and anthropic/claude-haiku-4-5.
# OpenAI only: openai/gpt-4o and openai/gpt-4o-mini.
MODEL_STRONG_DEFAULT=
MODEL_FAST_DEFAULT=
# After the selected model (and the fast tier, when strong fails).
# OpenRouter names are fallbacks, not the primary model. LLM_API_BASE is not applied to openrouter/ models.
# MODEL_FALLBACKS=openai/gpt-4.1-mini,openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/nvidia/nemotron-3.5-super-vl:free
MODEL_FALLBACKS=
# Optional custom endpoints. GEMINI_API_BASE wins for Gemini calls; LLM_API_BASE is the generic override.
# openrouter/ models keep LiteLLM's own OpenRouter base.
GEMINI_API_BASE=
LLM_API_BASE=

# Outbound proxy. Inside Compose, point at the host proxy (v2rayN on Windows: port 10809).
# NO_PROXY must include the compose service names or Postgres, Redis, and SearXNG go through the proxy.
# Do not put the LLM host here (generativelanguage.googleapis.com, api.openai.com, or the host of LLM_API_BASE).
# If direct HTTPS is broken, those calls must still use the proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=postgres,redis,searxng,backend,frontend,worker,localhost,127.0.0.1

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

MAX_DISCOUNT_PERCENT=15
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
